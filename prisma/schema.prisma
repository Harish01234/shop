
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  jinis         Jinis[]
  jinisCharas   JinisChara[]
  interests     Interest[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum JinisType {
  GOLD
  SILVER
  BOTH
  UNKNOWN
}

enum JinisItemType {
  GOLD
  SILVER
}

model Jinis {
  id           String      @id @default(cuid())
  slNo         Int
  name         String
  fatherName   String
  phoneNo      String
  credit       Int
  type         JinisType
  /// Sum of items.wet where type is GOLD
  goldWeight   Float       @default(0)
  /// Sum of items.wet where type is SILVER
  silverWeight Float       @default(0)
  date         DateTime
  active       Boolean     @default(true)
  settledAt    DateTime?
  createdById  String
  createdBy    User        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        JinisItem[]
  interests    Interest[]

  @@index([slNo])
  @@index([name])
  @@index([phoneNo])
  @@index([date])
  @@index([active])
  @@index([settledAt])
}

model JinisItem {
  id        String        @id @default(cuid())
  name      String
  wet       Float
  type      JinisItemType
  jinisId   String
  jinis     Jinis         @relation(fields: [jinisId], references: [id], onDelete: Cascade)

  @@index([jinisId])
  @@index([type])
}

model JinisChara {
  id          String     @id @default(cuid())
  slNo        Int
  name        String
  fatherName  String
  phoneNo     String
  credit      Int
  percentage  Float
  description String?
  date        DateTime
  active      Boolean    @default(true)
  settledAt   DateTime?
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  interests   Interest[]

  @@index([slNo])
  @@index([name])
  @@index([phoneNo])
  @@index([date])
  @@index([active])
  @@index([settledAt])
}

model Interest {
  id           String      @id @default(cuid())
  amount       Int
  date         DateTime
  remarks      String?
  jinisId      String?
  jinis        Jinis?      @relation(fields: [jinisId], references: [id], onDelete: Restrict)
  jinisCharaId String?
  jinisChara   JinisChara? @relation(fields: [jinisCharaId], references: [id], onDelete: Restrict)
  personName   String?
  createdById  String
  createdBy    User        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([date])
  @@index([jinisId])
  @@index([jinisCharaId])
  @@index([personName])
}


